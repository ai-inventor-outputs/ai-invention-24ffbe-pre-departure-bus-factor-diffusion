 is h", "total_commit_count": 1449, "history_years": 13.44}, "founder_signal": {"year1_top_author_email": "crsmithdev@gmail.com", "year1_top_author_share": 0.4835}, "truncated": false, "commit_cap": 5000, "commits": [{"sha": "2224255c4acc594d734cef0bbc83360452a67983", "author_email": "me@krisfremen.com", "author_name": "Kristijan \"Fremen\" Velkovski", "date": "2026-04-30T03:13:11-05:00", "files": [{"path": "arrow/arrow.py", "insertions": 9, "deletions": 11}]}, {"sha": "b423717da81aaf8117313b4b377efaa6413a9639", "author_email": "34209028+veeceey@users.noreply.github.com", "author_name": "Varun Chawla", "date": "2026-02-19T07:24:45-08:00", "files": [{"path": "arrow/arrow.py", "insertions": 11, "deletions": 9}]}, {"sha": "67ca577fb248ce9d803a9a85584b90a77ca989f0", "author_email": "me@krisfremen.com", "author_name": "Kristijan \"Fremen\" Velkovski", "date": "2026-02-18T21:17:06-06:00", "files": [{"path": ".github/workflows/continuous_integration.yml", "insertions": 3, "deletions": 1}]}, {"sha": "b247ad073d4c350270528edb5afff8e7f4f7d9e4", "author_email": "jason.d.mitchell03@gmail.com", "author_name": "Jason Mitchell", "date": "2025-12-15T20:41:26-08:00", "files": [{"path": "arrow/locales.py", "insertions": 2, "deletions": 0}, {"path": "tests/test_locales.py", "insertions": 5, "deletions": 0}]}, {"sha": "9da15b8fd2159c3b5c74ed6c505c22a6ec062332", "author_email": "49699333+dependabot[bot]@users.noreply.github.com", "author_name": "dependabot[bot]", "date": "2025-12-14T21:43:28-08:00", "files": [{"path": ".github/workflows/continuous_integration.yml", "insertions": 3, "deletions": 3}, {"path": ".github/workflows/release.yml", "insertions": 1, "deletions": 1}]}, {"sha": "598b72a3019baf58f29200087addcfc1a35648c9", "author_email": "70592529+ABolouk@users.noreply.github.com", "author_name": "Amirhosein Bolouk Asli", "date": "2025-12-15T09:08:12+03:30", "files": [{"path": "tests/test_locales.py", "insertions": 375, "deletions": 0}]}, {"sha": "53274f91fea4fad0c496c43ff2c1e64da8a